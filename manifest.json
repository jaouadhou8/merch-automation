{
  "manifest_version": 3,
  "name": "Merch on Demand Bulk Uploader",
  "version": "1.1.1",
  "description": "Bulk upload t-shirt designs to Amazon Merch on Demand from a CSV file",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://merch.amazon.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open Merch Bulk Uploader"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://merch.amazon.com/*"
      ],
      "css": [
        "content-styles.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "102"
}
